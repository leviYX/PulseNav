# 示例文件不会被程序自动读取；通过 shell 或部署系统注入环境变量。
PULSE_ADDR=127.0.0.1:8080
# demo 使用合成数据；postgis 需要先执行迁移，数据库故障不会回退到 demo。
POI_MODE=demo
DATABASE_URL=postgres://pulsegeo:pulsegeo_local@127.0.0.1:5432/pulsegeo?sslmode=disable
# 同时留空时 Agent 禁用，确定性 API 仍可运行。
OPENAI_API_KEY=
OPENAI_MODEL=
# 留空使用适配器默认地址；兼容服务通常填写 https://your-provider/v1。
OPENAI_BASE_URL=
